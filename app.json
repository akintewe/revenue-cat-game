{
  "expo": {
    "name": "Prysm",
    "slug": "revenue-cat-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prysm",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nathanakin.revenuecatgame",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090909",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nathanakin.revenuecatgame",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF5A3C"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Prysm uses your photo library to attach images to posts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-pyramid.png",
          "imageWidth": 34,
          "resizeMode": "contain",
          "backgroundColor": "#FD5021"
        }
      ],
      "expo-share-intent",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.610135379378-vh79ejfl909emvu1sv23d0fn1i8qo46u"
        }
      ]
    ],
    "extra": {
      "revenueCatApiKeyIos": "",
      "revenueCatApiKeyAndroid": "",
      "googleWebClientId": "610135379378-mh9odm2nv1sb60s0hrq5nmr68ckbgs9u.apps.googleusercontent.com",
      "googleIosClientId": "610135379378-vh79ejfl909emvu1sv23d0fn1i8qo46u.apps.googleusercontent.com",
      "eas": {
        "projectId": "4c28ff2a-446c-4a5f-9499-9050d7a8489f"
      }
    },
    "owner": "prysmapp"
  }
}
